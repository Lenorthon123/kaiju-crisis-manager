# ---- Server ----
# Twelve-Factor: the port is read from the environment, never hardcoded.
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed origins. `*` reflects whoever asks, which is
# fine locally and never in production.
CORS_ORIGIN=http://localhost:5173

# ---- Database ----
# Matches docker-compose.dev.yml (`npm run db:up`). Port 5433 on purpose, so it
# does not collide with a PostgreSQL already installed on the machine.
DATABASE_URL="postgresql://kaiju:kaiju@localhost:5433/kaiju?schema=public"

# ---- Auth ----
JWT_SECRET="change-me-in-your-own-.env"
JWT_EXPIRES_IN="12h"

# ---- Domain tuning (documented decisions, see docs/decisions.md) ----
# Base duration of one land leg, in hours.
TRANSFER_BASE_LEG_HOURS=2
# Maritime multiplier: the rules say "doubled delivery time".
TRANSFER_MARITIME_MULTIPLIER=2
# Default retention percentage and the level-5 lowered value.
RETENTION_DEFAULT_PCT=0.30
RETENTION_LOWERED_PCT=0.15
