{
  "extends": "./tsconfig.json",
  // `test` must be excluded, not just the spec files: compiling test/helpers
  // widens the inferred rootDir to the project root, which pushes the output to
  // dist/src/main.js and breaks `npm run start:prod` (`node dist/main`).
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
